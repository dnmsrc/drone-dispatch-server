# ────────────────────────────────────────────────
# drone-dispatch-server（服务端）忽略规则
# 原则：源码、配置模板、迁移脚本入库；构建产物、
#       本地口令/密钥、运行时数据不入库。
# ────────────────────────────────────────────────

# ── 构建产物（Maven / Gradle / javac）──────────
target/
out/
build/
.gradle/
*.class

# ── 日志与临时文件 ────────────────────────────
logs/
*.log
*.tmp

# ── Python 零星工具脚本 ────────────────────────
__pycache__/
*.pyc

# ── 本地配置（含数据库口令、第三方密钥，严禁入库）──
application-local.*
*.local
.env
.env.*

# ── 运行时数据 ─────────────────────────────────
uploads/
data/

# ── 编辑器 / 系统 ─────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.suo
*.sw?
*.bak
*.orig
